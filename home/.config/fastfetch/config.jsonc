{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "position": "top"
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#33}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#35}󰌢 host    {#keys}│",
            "type": "host"
        },
        {
            "key": "│ {#36} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#31}󰇄 desktop {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#32} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#33} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#34}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#35}󰢮 gpu     {#keys}│",
            "type": "gpu"
        },
        {
            "key": "│ {#36}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#31} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#32}󰓡 swap    {#keys}│",
            "type": "swap"
        },
        {
            "key": "│ {#33}󰩟 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "│ {#34}󰃭 os age  {#keys}│",
            "type": "disk",
            "folders": "/",
            "format": "{create-time:10} [{days} days]"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
