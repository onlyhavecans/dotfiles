// Noctalia v5 shell overlay: everything that talks to the bar, launcher,
// OSD, lock screen, and notifications lives here.
// see: https://docs.noctalia.dev/noctalia/compositor-settings/niri/

spawn-at-startup "noctalia"

// Colors noctalia.kdl does not render; pinned to Everforest Light Hard.
// See docs/everforest.md.
layout {
  gaps 5
  focus-ring {
    width 3
  }
  shadow {
    color "#8da10166"          // green
    inactive-color "#bec5b240" // bg5
  }
  background-color "#fffbef"   // bg0
}

overview {
  backdrop-color "#f2efdf"     // bg_dim
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

switch-events {
  lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
}

binds {
  // Launchers and panels
  Alt+Space hotkey-overlay-title="open launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
  Mod+Space hotkey-overlay-title="open which-key menu" { spawn "~/bin/wlr-toggle"; }
  Alt+Comma hotkey-overlay-title="open emoji search" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo "; }
  Alt+N hotkey-overlay-title="show clipboard history" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
  Alt+Tab hotkey-overlay-title="select window" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/win"; }

  Mod+N hotkey-overlay-title="show notification history" { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
  Mod+S hotkey-overlay-title="control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
  Mod+Escape hotkey-overlay-title="power menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
  Mod+Comma hotkey-overlay-title="shell settings" { spawn "noctalia" "msg" "settings-toggle"; }
  Mod+Alt+Comma hotkey-overlay-title="toggle bar" { spawn "noctalia" "msg" "bar-toggle"; }
  Mod+Period hotkey-overlay-title="run task" { spawn "~/bin/wlr-toggle" "tasks"; }

  XF86AudioMedia hotkey-overlay-title="lock" { spawn "noctalia" "msg" "session" "lock"; }  // Framework Key

  // Screenshots
  Print hotkey-overlay-title="Screenshot Region" { spawn "noctalia" "msg" "screenshot-annotate"; }
  Mod+Print hotkey-overlay-title="Record Screen" { spawn "~/bin/record-screen"; }

  // Through Noctalia IPC so the OSD shows.
  XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
  XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
  XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

  XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
  XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
  XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }

  XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
  XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
}
