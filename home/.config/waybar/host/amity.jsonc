{
  // 2x panel: drop the window title so the bigger taskbar icons fit
  "modules-left": ["group/nix", "niri/workspaces", "mpris"],
  "group/levels": {
    "modules": ["group/audio", "group/mic", "group/light", "battery"]
  },
  "group/light": {
    "orientation": "inherit",
    "drawer": { "transition-duration": 300, "reveal-delay": 150 },
    "modules": ["backlight", "backlight/slider"]
  }
}
