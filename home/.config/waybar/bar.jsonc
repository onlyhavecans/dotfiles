{
  // Geometry and module layout shared by every bar; per-bar deltas live in config.jsonc.
  "layer": "top",
  "reload_style_on_change": true,
  "margin-left": 5,
  "margin-right": 5,
  "margin-top": 3,
  "margin-bottom": 0,
  "height": 30,
  "spacing": 4,
  "modules-left": ["group/nix", "niri/workspaces", "mpris"],
  "modules-center": ["custom/tomat"],
  "modules-right": ["group/alerts", "group/levels", "group/links", "group/time"]
}
