// One layout, two bars; the laptop panel only shortens text.
// Precedence: bar object > host.jsonc > bar.jsonc > modules/*.jsonc (objects deep-merge, first wins).
// wide: any output over 2000 logical px (after scale), so the 1.5x BOE panel
// (1706 wide) gets no bar. compact: the laptop panel by connector name.
// Fallback if a screen misbehaves: "output" ids are "<make> - <model> - <connector>"
// (see `waybar -l debug`), e.g. ["!eDP-1", "!BOE - Display - HDMI-A-1", "*"].
[
  {
    "name": "wide",
    "output-dimensions": "width > 2000",
    "include": [
      "~/.config/waybar/host.jsonc",
      "~/.config/waybar/bar.jsonc",
      "~/.config/waybar/modules/*.jsonc"
    ]
  },
  {
    "name": "compact",
    "output": "eDP-1",
    "include": [
      "~/.config/waybar/host.jsonc",
      "~/.config/waybar/bar.jsonc",
      "~/.config/waybar/modules/*.jsonc"
    ],
    "niri/window": { "max-length": 16 },
    "mpris": { "artist-len": 0, "title-len": 20 }
  }
]
