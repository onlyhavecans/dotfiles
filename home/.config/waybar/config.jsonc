{
  "margin-left": 5,
  "margin-right": 5,
  "margin-top": 3,
  "margin-bottom": 0,
  "height": 30,
  "spacing": 0,
  "modules-left": [
    "group/hardware",
    "niri/workspaces",
    "tray"
  ],
  "modules-center": [
    "mpris",
    "custom/tomat"
  ],
  "modules-right": [
    "systemd-failed-units",
    "privacy",
    "custom/recording",
    "custom/voxtype",
    "group/sound",
    "network#wifi",
    "network#vpn",
    "bluetooth",
    "battery",
    "power-profiles-daemon",
    "idle_inhibitor",
    "custom/dnd",
    "group/time"
  ],
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "start-expanded": true
    },
    "modules": [
      "custom/nix",
      "cpu",
      "memory",
      "disk",
      "temperature",
      "custom/gpu-usage"
    ]
  },
  "custom/nix": {
    "format": "󱄅",
    "tooltip": false
  },
  "cpu": {
    "format": "󰍛{usage:2}",
    "interval": 5,
    "states": {
      "warning": 80,
      "critical": 95
    }
  },
  "memory": {
    "format": "󰘚{percentage:2}",
    "interval": 10,
    "states": {
      "warning": 80,
      "critical": 95
    },
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },
  "disk": {
    "format": "󰋊{percentage_used}",
    "path": "/",
    "interval": 60,
    "states": {
      "warning": 85,
      "critical": 95
    },
    "tooltip-format": "{used} / {total} ({percentage_used}%)"
  },
  "temperature": {
    "hwmon-path-abs": [
      "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
      "/sys/devices/platform/coretemp.0/hwmon"
    ],
    "input-filename": "temp1_input",
    "format": "󰔏{temperatureC:2}",
    "interval": 5,
    "warning-threshold": 80,
    "critical-threshold": 90,
    "tooltip": false
  },
  "custom/gpu-usage": {
    "format": "{icon}{text} ",
    "exec": "gpu-usage-waybar --text-format '{gpu_utilization}󰘚{mem_utilization}󰔏{temperature}' --interval 10000",
    "return-type": "json",
    "format-icons": "󰾲",
    "on-click": "foot amg_gputop"
  },
  "niri/workspaces": {
    "format": "{value}"
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-separator": " | ",
    "dynamic-order": [
      "title",
      "artist",
      "album"
    ],
    "dynamic-len": 70,
    "player-icons": {
      "default": "󰐊",
      "Feishin": "󰝚",
      "mpv": "󰕧"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "ignored-players": [
      "brave",
      "chromium"
    ]
  },
  "custom/tomat": {
    "exec": "tomat watch --interval 1",
    "return-type": "json",
    "format": "{text}",
    "tooltip": true,
    "on-click": "tomat toggle",
    "on-click-right": "tomat skip"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 4
  },
  "privacy": {
    "icon-size": 18
  },
  "custom/recording": {
    "exec": "pgrep -x wf-recorder >/dev/null && echo '󰻃' || echo ''",
    "on-click": "pkill -INT --older 5 -x wf-recorder",
    "restart-interval": 3
  },
  "custom/voxtype": {
    "exec": "voxtype status --follow --format json --extended",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "󰗋",
      "transcribing": "󰔟",
      "stopped": "󰻔"
    },
    "tooltip": true,
    "on-click": "voxtype toggle",
    "on-click-right": "systemctl --user restart voxtype"
  },
  "custom/dnd": {
    "exec": "[[ \"$(makoctl mode)\" =~ 'do-not-disturb' ]] && echo '󰂛' || echo '󰂜'",
    "interval": "once",
    "on-click": "makoctl mode -t do-not-disturb; pkill -RTMIN+11 waybar",
    "signal": 11,
    "tooltip": false
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "signal": 8
  },
  "systemd-failed-units": {
    "hide-on-ok": true,
    "format": "󰒓{nr_failed}",
    "system": true,
    "user": true,
    "tooltip-format": "System: {nr_failed_system}\nUser: {nr_failed_user}",
    "tooltip-unit-format": "{scope}: {name} ({active_state})"
  },
  "network#vpn": {
    "interface": "wg*",
    "family": "ipv4_6",
    "format": "󰒃",
    "format-disconnected": "",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "network#wifi": {
    "interface": "wl*",
    "family": "ipv4_6",
    "format": "{icon}{signalStrength}",
    "format-disconnected": "",
    "format-icons": [
      "󰟂",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format": "{essid}\n{ifname}: {ipaddr}/{cidr}\nSignal: {signalStrength}% Frequency: {frequency}\n⬆ {bandwidthUpBytes}  ⬇ {bandwidthDownBytes}"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "󰂱{num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  "group/sound": {
    "orientation": "inherit",
    "modules": [
      "wireplumber",
      "wireplumber#source"
    ]
  },
  "wireplumber": {
    "format": "{icon}{volume}",
    "format-muted": "󰝟",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 100%",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "scroll-step": 5
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "{icon}{volume}",
    "format-muted": "󰍭",
    "format-icons": [
      "󰍮",
      "󰍬"
    ],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 100%",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+ -l 1.0",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
    "scroll-step": 5
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "󰁹",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 5
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
      "on-charging-100": "notify-send -u normal 'Battery Full!'"
    },
    "format": "{icon}{capacity}",
    "format-full": "{icon}{capacity}",
    "format-charging": "󰂄{capacity}",
    "format-plugged": "󰚥{capacity}",
    "format-alt": "{icon}{time}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "group/time": {
    "orientation": "horizontal",
    "modules": [
      "clock#date",
      "clock"
    ]
  },
  "clock": {
    "format": "󰥔{:%H:%M}",
    "tooltip-format": "{tz_list}",
    "timezone-tooltip-format": "{:%Z: %H:%M %m-%d}",
    "timezones": [
      "America/Los_Angeles",
      "America/Denver",
      "America/Chicago",
      "America/New_York",
      "America/Argentina/Buenos_Aires",
      "UTC",
      "Europe/Paris"
    ],
    "actions": {
      "on-click": "tz_up",
      "on-click-right": "tz_down"
    }
  },
  "actions": {
    "on-scroll-up": "shift_up",
    "on-scroll-down": "shift_down"
  },
  "clock#date": {
    "format": "{:%a %m-%d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "{}",
        "weeks": "<i>w{}</i>",
        "weekdays": "{}",
        "today": "<span color='#fb4934'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click": "shift_up",
      "on-click-right": "shift_down"
    }
  }
}
