// Two bars keyed on output; everything else lives in bars/, modules/, host/.
// Include precedence: this object > host.jsonc > bars/<bar>.jsonc > modules/*.jsonc
// Output ids are "<make> - <model> - <connector>"; see `waybar -l debug`.
[
  {
    "name": "wide",
    "output": ["!eDP-1", "!BOE - Display - HDMI-A-1", "*"],
    "include": [
      "~/.config/waybar/host.jsonc",
      "~/.config/waybar/bars/wide.jsonc",
      "~/.config/waybar/modules/*.jsonc"
    ]
  },
  {
    "name": "compact",
    "output": "eDP-1",
    "include": [
      "~/.config/waybar/host.jsonc",
      "~/.config/waybar/bars/compact.jsonc",
      "~/.config/waybar/modules/*.jsonc"
    ]
  }
]
