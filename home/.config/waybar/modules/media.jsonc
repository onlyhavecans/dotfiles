{
  "group/media": {
    "orientation": "inherit",
    "modules": ["image#art", "mpris"]
  },
  "image#art": {
    "exec": "~/bin/album-art",
    "size": 18,
    "interval": 5,
    "tooltip": false
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-separator": " | ",
    "dynamic-order": ["title", "artist"],
    "dynamic-importance-order": ["title", "artist"],
    "dynamic-len": 50,
    "title-len": 40,
    "tooltip-format": "{player}: {title}\n{artist} — {album}",
    "player-icons": {
      "default": "󰐊",
      "Feishin": "󰝚",
      "ratune": "󰝚",
      "mpv": "󰕧"
    },
    "status-icons": { "paused": "󰏤" },
    "ignored-players": ["brave", "chromium"]
  }
}
