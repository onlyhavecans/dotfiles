{
  // click cycles timezones; scroll moves the calendar month
  "clock": {
    "format": "{:%a %d, %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>\n\n{tz_list}",
    "timezone-tooltip-format": "{:%Z: %H:%M %m-%d}",
    "timezones": [
      "",
      "America/Los_Angeles",
      "America/Denver",
      "America/Chicago",
      "America/New_York",
      "America/Argentina/Buenos_Aires",
      "UTC",
      "Europe/Paris"
    ],
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "weeks-numbering": "iso",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "{}",
        "weeks": "<i>w{}</i>",
        "weekdays": "{}",
        "today": "<span color='#F85552'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click": "tz_up",
      "on-click-right": "tz_down",
      "on-click-middle": "shift_reset",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
