#!/usr/bin/env python3
"""Diff noctalia's GUI state file against the committed base layer.

Usage:
  noctalia-diff                  overview: every state override, where it belongs
  noctalia-diff extract PATH     print a paste-ready TOML snippet for a dotted
                                 path (e.g. `theme` or `bar.default`)

The base layer is ~/.config/noctalia/*.toml merged alphabetically; the state
file ~/.local/state/noctalia/settings.toml overrides it. Everything shown is
either machine-specific or not yet migrated to the repo.
"""

import sys
import tomllib
from pathlib import Path

CONFIG_DIR = Path.home() / ".config/noctalia"
STATE_FILE = Path.home() / ".local/state/noctalia/settings.toml"
IGNORE = {"config_version", "wallpaper.last"}


def deep_merge(dst, src):
    for k, v in src.items():
        if isinstance(v, dict) and isinstance(dst.get(k), dict):
            deep_merge(dst[k], v)
        else:
            dst[k] = v


def load_base():
    merged, owners = {}, {}
    for f in sorted(CONFIG_DIR.glob("*.toml")):
        data = tomllib.loads(f.read_text())
        for top in data:
            owners.setdefault(top, f.name)
        deep_merge(merged, data)
    return merged, owners


def walk(d, prefix=""):
    """Yield (dotted_path, leaf_value); array-of-tables counts as a leaf."""
    for k, v in d.items():
        key = f"{prefix}.{k}" if prefix else k
        if isinstance(v, dict):
            yield from walk(v, key)
        else:
            yield key, v


def dig(d, path):
    for part in path.split("."):
        if not isinstance(d, dict) or part not in d:
            return None
        d = d[part]
    return d


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, str):
        return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'
    if isinstance(v, float):
        s = repr(v)
        return s if "." in s or "e" in s else s + ".0"
    if isinstance(v, list):
        return "[ " + ", ".join(toml_value(x) for x in v) + " ]"
    return repr(v)


def quote_key(k):
    return k if k.replace("-", "").replace("_", "").isalnum() else f'"{k}"'


def emit(d, prefix, out):
    scalars = {k: v for k, v in d.items() if not isinstance(v, (dict, list))}
    plain_lists = {k: v for k, v in d.items()
                   if isinstance(v, list) and not (v and isinstance(v[0], dict))}
    tables = {k: v for k, v in d.items() if isinstance(v, dict)}
    aot = {k: v for k, v in d.items()
           if isinstance(v, list) and v and isinstance(v[0], dict)}

    if (scalars or plain_lists) and prefix:
        out.append(f"[{prefix}]")
    for k, v in {**scalars, **plain_lists}.items():
        out.append(f"{quote_key(k)} = {toml_value(v)}")
    for k, v in tables.items():
        if out:
            out.append("")
        emit(v, f"{prefix}.{quote_key(k)}" if prefix else quote_key(k), out)
    for k, items in aot.items():
        header = f"{prefix}.{quote_key(k)}" if prefix else quote_key(k)
        for item in items:
            if out:
                out.append("")
            out.append(f"[[{header}]]")
            for ik, iv in item.items():
                if isinstance(iv, dict):
                    emit(iv, f"{header}.{quote_key(ik)}", out)
                else:
                    out.append(f"{quote_key(ik)} = {toml_value(iv)}")


def to_toml(value, path):
    out = []
    if isinstance(value, dict):
        emit(value, path, out)
    elif isinstance(value, list) and value and isinstance(value[0], dict):
        emit({path.rsplit(".", 1)[-1]: value},
             path.rsplit(".", 1)[0] if "." in path else "", out)
    else:
        parent, _, key = path.rpartition(".")
        if parent:
            out.append(f"[{parent}]")
        out.append(f"{quote_key(key)} = {toml_value(value)}")
    return "\n".join(out)


def main():
    base, owners = load_base()
    state = tomllib.loads(STATE_FILE.read_text())

    if len(sys.argv) >= 3 and sys.argv[1] == "extract":
        path = sys.argv[2]
        value = dig(state, path)
        if value is None:
            sys.exit(f"'{path}' not found in {STATE_FILE}")
        top = path.split(".")[0]
        dest = owners.get(top, f"{top}.toml (new file)")
        print(f"# -> {CONFIG_DIR}/{dest}")
        print(to_toml(value, path))
        return

    rows = []
    for path, val in walk(state):
        if any(path == i or path.startswith(i + ".") for i in IGNORE):
            continue
        base_val = dig(base, path)
        top = path.split(".")[0]
        dest = owners.get(top, f"{top}.toml*")
        if base_val is None:
            rows.append(("new", path, dest, val, None))
        elif base_val != val:
            rows.append(("changed", path, dest, val, base_val))

    if not rows:
        print("state matches base (nothing to migrate)")
        return
    width = max(len(r[1]) for r in rows)
    for kind, path, dest, val, base_val in rows:
        tag = "+" if kind == "new" else "~"
        line = f"{tag} {path:<{width}}  -> {dest}"
        if kind == "changed":
            old, new = toml_value(base_val), toml_value(val)
            if len(old) + len(new) > 100:
                line += "  (differs; run extract to compare)"
            else:
                line += f"  ({old} => {new})"
        else:
            v = toml_value(val)
            line += f"  = {v if len(v) <= 100 else '(large; run extract)'}"
        print(line)
    print(f"\n{len(rows)} override(s). '*' = no base file owns this table yet.")
    print("Snippet: noctalia-diff extract <dotted.path>")


if __name__ == "__main__":
    main()
