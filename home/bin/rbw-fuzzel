#!/usr/bin/env bash
# Pick a Bitwarden entry with fuzzel and copy its password.
# rbw unlocks through pinentry when the agent is locked.
set -euo pipefail

entry=$(rbw list --fields name,user | fuzzel --dmenu --width 50 --prompt="Password: ") || exit 0
[[ -n $entry ]] || exit 0

name=$(cut -f1 <<<"$entry")
user=$(cut -f2 <<<"$entry")

if [[ -n $user ]]; then
  rbw get "$name" "$user" | wl-copy --trim-newline
else
  rbw get "$name" | wl-copy --trim-newline
fi
notify-send "rbw" "Copied password for ${name}"
