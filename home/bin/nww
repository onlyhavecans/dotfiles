#!/usr/bin/env bash
# Resize the focused umbriel window so its terminal grid is N columns
# (default 80). A +N arg adds N extra pixels to the width.
set -euo pipefail

cols=80 pad=0
for arg in "$@"; do
  case $arg in
    +*) pad=${arg#+} ;;
    *) cols=$arg ;;
  esac
done

fail() { notify-send "NWW" "Window detection failed"; exit 2; }

read -r pid w output < <(umbriel focused-window --json | jq -r '"\(.pid) \(.w) \(.output)"')
read -r scale view < <(umbriel outputs --json |
  jq -r --arg o "$output" '.[] | select(.name == $o) | "\(.scale) \(.usable_area.width)"')
gap=$(umbriel config get layout.gap)
bw=$(umbriel config get appearance.border_width)

pts=$(ps -o tty= --ppid "$pid" | awk '/pts/ { print $1; exit }')
[[ -n $pts ]] || fail
cur_cols=$(stty -F "/dev/$pts" size | cut -d' ' -f2)

# Cell width = physical width / columns. Round the target up to a
# logical pixel. Extent is a fraction of (viewport - gap); the tile
# then loses one gap and both borders.
frac=$(awk -v c="$cols" -v cc="$cur_cols" -v w="$w" -v s="$scale" \
  -v p="$pad" -v g="$gap" -v b="$bw" -v v="$view" 'BEGIN {
    t = c * int(w * s / cc) / s
    t = (t == int(t) ? t : int(t) + 1) + p
    printf "%.6f", (t + g + 2 * b + 0.5) / (v - g)
  }')
umbriel msg window-set-primary-extent "$frac"
