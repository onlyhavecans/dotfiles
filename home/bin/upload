#!/usr/bin/env bash

if [[ -z "$*" ]]; then
  echo "usage: $0 [files]"
  exit 1
fi

# Proton Pass: Personal vault, "Zipline" item (ids are ~5x faster than --item-title)
ZIPLINE_ITEM=(
  --share-id BZ_ZudkOoossTRnklUKe0o3aKxgV6NmnEgwtEOAUDyHuhXDoQztLZj2yCt4dkRkmVsO19fxjI7zJq0vHwzVE5A==
  --item-id ix8vuUnZi7ZhEg4uUPSESh39qUJbp5eg7qFyhTQhF-0ROPnqg7ZdfPHM1htxuFV9JpEQPtwsN5iGnyd44dj_dA==
)
TOKEN=$(pass-cli item view "${ZIPLINE_ITEM[@]}" --field api-key)
URL=$(pass-cli item view "${ZIPLINE_ITEM[@]}" --field api-upload-url)

if [[ -z "$TOKEN" || -z "$URL" ]]; then
  echo "No upload till you auth"
fi

for i in "$@"; do
  UPLOAD_URL=$(
    curl \
      "$URL" \
      --header "authorization: $TOKEN" \
      --header 'content-type: multipart/form-data' \
      --form file=@"$i" |
      jq --raw-output .files[0].url
  )

  if [[ -n "$UPLOAD_URL" ]]; then
    echo "$UPLOAD_URL" | wl-copy
    notify-send "uploader" "Uploaded to $UPLOAD_URL"
  fi

done
