#!/usr/bin/env bash

if [[ -z "$*" ]]; then
  echo "usage: $0 [files]"
  exit 1
fi

TOKEN=$(op read "op://Personal/Zipline/api-key")
URL=$(op read "op://Personal/Zipline/api-upload-url")

if [[ -z "$TOKEN" || -z "$URL" ]]; then
  echo "No upload till you auth"
fi

for i in "$@"; do
  UPLOAD_URL=$(
    curl \
      "$URL" \
      --header "authorization: $TOKEN" \
      --header 'content-type: multipart/form-data' \
      --form file=@"$i" |
      jq --raw-output .files[0].url
  )

  if [[ -n "$UPLOAD_URL" ]]; then
    echo "$UPLOAD_URL" | wl-copy
    notify-send "uploader" "Uploaded to $UPLOAD_URL"
  fi

done
