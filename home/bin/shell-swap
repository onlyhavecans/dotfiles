#!/usr/bin/env bash
# shell-swap dms|noctalia
# Live-swap the desktop shell: flip the niri overlay include and the systemd
# user units. `shell-select.nix` picks which one autostarts after reboot.
set -euo pipefail

niri_dir="${HOME}/.config/niri"
target=${1:?usage: shell-swap dms|noctalia}

case "$target" in
  dms) other=noctalia ;;
  noctalia) other=dms ;;
  *)
    echo "usage: shell-swap dms|noctalia" >&2
    exit 1
    ;;
esac

ln -sf "shell/${target}.kdl" "${niri_dir}/shell.kdl"
# nudge niri to reload the include chain
touch "${niri_dir}/config.kdl"

systemctl --user stop "${other}.service" 2>/dev/null || true
systemctl --user start "${target}.service"
notify-send "shell-swap" "now running ${target}"
