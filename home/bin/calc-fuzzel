#!/usr/bin/env bash
# Calculate and convert units with qalc in a fuzzel text box.
# Each result goes to the clipboard and shows in the next prompt.
# Start with an operator to continue from the last result, e.g. "* 2".
# An empty line or Escape quits.
set -euo pipefail

if ! command -v qalc >/dev/null; then
  notify-send "Calc" "qalc not found. Install libqalculate."
  exit 1
fi

calc() { qalc -t -- "$1" 2>&1 | tail -1; }

last=""
prompt="Calc: "
while expr=$(fuzzel --dmenu --width 40 --prompt-only="$prompt" </dev/null) && [[ -n $expr ]]; do
  [[ -n $last && $expr =~ ^[-+*/^] ]] && expr="($last) $expr"

  result=$(calc "$expr")
  # qalc splits "to mi" into mi + yd + in. "to -mi" gives one unit.
  if [[ $expr == *" to "* && $result == *" + "* ]]; then
    result=$(calc "${expr/ to / to -}")
  fi

  wl-copy -- "$result"
  last=$result
  prompt="$result ❯ "
done
