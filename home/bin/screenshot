#!/usr/bin/env bash

case "${1:-region}" in
  window)
    niri msg action screenshot-window --write-to-disk false
    sleep 0.2
    wl-paste | satty --filename -
    ;;
  screen)
    output=$(niri msg --json focused-output | jq --raw-output '.name')
    grim -o "$output" -t ppm - | satty --filename -
    ;;
  selection)
    grim -g "$(slurp)" -t ppm - | satty --filename -
    ;;
  *)
    echo "usage: $0 [window|screen|selection]"
    exit 1
    ;;
esac
