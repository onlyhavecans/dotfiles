#!/usr/bin/env bash
# inbox-dictate [seconds]
# Record a short voice note, transcribe it offline with voxtype,
# and save it to the vault inbox via inbox. Never types into the focused window.
set -euo pipefail

secs="${1:-5}"
wav=$(mktemp --suffix=.wav)
trap 'rm -f "$wav"' EXIT

notify-send -t "$((secs * 1000))" "Inbox" "Recording ${secs}s..."
ffmpeg -hide_banner -loglevel error -f pulse -i default \
  -t "$secs" -ar 16000 -ac 1 -y "$wav"

text=$(voxtype transcribe "$wav")
if [[ -z $text ]]; then
  notify-send "Inbox" "Nothing transcribed"
  exit 1
fi

~/bin/inbox "$text" >/dev/null
notify-send "Inbox" "Saved: $text"
