#!/usr/bin/env bash

function status_message {
  GREEN='\033[0;32m'
  NOCOLOR='\033[0m'
  echo ""
  echo -e "${GREEN}~ Starting $*${NOCOLOR}"
}

status_message "Performance Mode"
powerprofilesctl set performance

status_message "Set Audio"
wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
wpctl set-volume @DEFAULT_AUDIO_SINK@ 100%
wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 100%

# Re-fire a steam://rungameid URL until its window appears
function launch_steam_app {
  local appid=$1 window=$2
  while ! niri msg windows | grep -qi "$window"; do
    steam -ifrunning "steam://rungameid/$appid"
    for _ in {1..10}; do
      niri msg windows | grep -qi "$window" && return
      sleep 2
    done
  done
}

status_message "Steam"
niri msg action spawn -- steam
while ! pgrep -x steam >/dev/null || [ ! -e ~/.steam/steam.pipe ]; do
  sleep 1
done

status_message "Firebot"
niri msg action spawn -- firebot

status_message "Discord"
niri msg action spawn -- discord

status_message "Music"
niri msg action spawn -- amberol

status_message "Obsidian"
xdg-open "obsidian://open?vault=Vault&file=notes%2FStream%20Startup%20Checklist" &

status_message "Dashboard"
xdg-open "https://dashboard.twitch.tv/u/xx_myrii_xx/stream-manager" &

status_message "VBridger"
launch_steam_app 1898830 "VBridger"

status_message "VTube Studio"
launch_steam_app 1325860 "VTube Studio"

status_message "OBS-Studio"
niri msg action spawn -- obs

status_message "Holding on current song"
current_song --player io.bassi.Amberol
