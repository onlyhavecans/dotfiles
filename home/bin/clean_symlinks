#!/usr/bin/env bash

##
# Clean up after removing things from homeshick castles
##

echo "~~ cleaning links directories"
fd --hidden --follow --type symlink \
  --exclude .local/share/Steam \
  --exclude .local/share/containers \
  --exclude .local/share/docker \
  --exclude .local/share/flatpak \
  --exclude .local/state/Steam \
  --exclude .local/state/nix \
  --exclude .nix-defexpr \
  --exclude .steam \
  --exclude .var/app \
  --exclude Code \
  --exclude Desktop \
  --exclude Documents \
  --exclude Library \
  --exclude OrbStack \
  --exclude Photos \
  --exclude lock \
  . ~ \
  --exec rm -v {}

echo "~~ cleaning empty directories"
fd --hidden --type empty --type directory \
  --exclude .config/espanso/match/packages \
  --exclude .local/share/Steam \
  --exclude .local/share/containers \
  --exclude .local/share/docker \
  --exclude .local/share/flatpak \
  --exclude .local/state/Steam \
  --exclude .local/state/nix \
  . ~ \
  --exec rmdir -v {}
