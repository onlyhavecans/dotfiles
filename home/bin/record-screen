#!/usr/bin/env bash

echo "Checking for previous run"
if pkill -INT --older 2 --exact wf-recorder; then
  notify-send Recorder "Recorder stopped"
  exit 0
fi

start_time=$(date +"%Y-%m-%d_%H:%M:%S")
outfile=$HOME/Pictures/Screenshots/recording_${start_time}.mp4

notify-send Recorder "Recorder started"
exec wf-recorder --no-damage --geometry "$(slurp)" --file "$outfile"
