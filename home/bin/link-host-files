#!/usr/bin/env bash
# Link machine-specific config variants into place.
# Configs include a fixed path (e.g. host.kdl); we point it at hosts/<hostname>.<ext>

function short_hostname {
  hostname -s | tr '[:upper:]' '[:lower:]'
}

# link_host_file <target-link>
# Links <target-minus-ext>/<hostname>.<ext> to <target-link>,
function link_host_file {
  local target=$1
  local src
  src="${target%.*}/$(short_hostname).${target##*.}"
  if [[ -e $src ]]; then
    ln -sf "$src" "$target"
    echo "linked: ${target} -> ${src}"
  else
    echo "no host file for $(short_hostname), skipping: ${target}"
  fi
}

##
# The links
##
host_links=(
  "${HOME}/.config/niri/host.kdl"
  "${HOME}/.config/waybar/host.jsonc"
)

for link in "${host_links[@]}"; do
  link_host_file "$link"
done

# The pywalfox addon (Firefox, Thunderbird) reads its colors from the wal cache
wal_colors="${HOME}/.config/pywalfox/everforest-light.json"
if [[ -e $wal_colors ]] && command -v pywalfox >/dev/null; then
  mkdir -p "${HOME}/.cache/wal"
  ln -sf "$wal_colors" "${HOME}/.cache/wal/colors.json"
  pywalfox light >/dev/null 2>&1
  pywalfox update >/dev/null 2>&1
  echo "linked: ${HOME}/.cache/wal/colors.json -> ${wal_colors}"
fi
