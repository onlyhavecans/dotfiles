#!/usr/bin/env bash
# Toggle the touchpad until the compositor exits.
set -euo pipefail

if [[ $(umbriel config get input.touchpad.enabled) == true ]]; then
  umbriel config set input.touchpad.enabled false
  state=Disabled
else
  umbriel config unset input.touchpad.enabled
  state=Enabled
fi

notify-send Umbriel "Touchpad is now $state"
