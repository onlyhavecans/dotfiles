#!/usr/bin/env bash
# focus-app-fuzzel [app-id-pattern]
# Jump to a niri window.
#
# With no arguments: pick from every window.
# With a pattern (case-insensitive regex against app-id):
#   multiple matches -> picker
#   one match -> focus it directly
#   no match -> error
set -euo pipefail

pattern="${1:-}"
font="Inter:size=24"

# Matching windows, ordered by on-screen position (column, then tile).
# Floating windows have no layout position and sort to the end.
windows=$(niri msg --json windows | jq -c --arg p "$pattern" '
  map(select($p == "" or (.app_id // "" | test($p; "i"))))
  | sort_by(.layout.pos_in_scrolling_layout // [999, 999])')

if [[ $windows == "[]" ]]; then
  notify-send "Focus App" "No $pattern windows found"
  exit 1
fi

mapfile -t ids < <(jq -r '.[].id' <<<"$windows")

if ((${#ids[@]} == 1)) && [[ -n $pattern ]]; then
  # A specific app with a single match: jump straight there
  idx=0
else
  # One line per window: "app_id | title" plus a fuzzel icon hint
  # (NUL "icon" US name). The icon name is the app_id lowercased with any
  # reverse-DNS prefix dropped, e.g. md.Obsidian -> obsidian.
  # --index maps the selection back to the window even with duplicate titles.
  idx=$(jq -r '
    ([0] | implode) as $nul | ([31] | implode) as $us
    | .[]
    | (.app_id // "unknown") as $app
    | (.title // "Untitled") as $title
    | ($app | ascii_downcase | split(".") | last) as $icon
    | "\($app) | \($title)\($nul)icon\($us)\($icon)"' <<<"$windows" |
    fuzzel --dmenu --index --font "$font" --width 60 --prompt="Window: ") || exit 0
  [[ -n $idx && $idx != -1 ]] || exit 0
fi

niri msg action focus-window --id "${ids[idx]}"
