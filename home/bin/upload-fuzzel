#!/usr/bin/env bash
# upload-fuzzel [dir]
# Pick a recent file from dir with fuzzel and upload it via zipline.
set -euo pipefail

dir="${1:-$HOME/Downloads}"

file=$(find "$dir" -maxdepth 1 -type f -printf '%T@\t%f\n' |
  sort -rn | cut -f2- | head -30 |
  fuzzel --dmenu --prompt="Upload: ") || exit 0
[[ -n $file ]] || exit 0

exec ~/bin/upload "$dir/$file"
